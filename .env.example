# Copia este archivo como .env (no se sube a git) y completa los valores.
# Lo usan los scripts de prueba contra Tomcat y Oracle; nunca se imprimen.
PSC_BASE_URL=http://localhost:8080/api

# Un usuario de prueba por rol (el de SUCURSAL debe pertenecer a una sucursal activa).
PSC_USUARIO_ADMINISTRADOR=
PSC_CLAVE_ADMINISTRADOR=
PSC_USUARIO_GERENTE=
PSC_CLAVE_GERENTE=
PSC_USUARIO_SUCURSAL=
PSC_CLAVE_SUCURSAL=
PSC_USUARIO_PRODUCCION=
PSC_CLAVE_PRODUCCION=
PSC_USUARIO_BODEGA=
PSC_CLAVE_BODEGA=
PSC_USUARIO_DESPACHO=
PSC_CLAVE_DESPACHO=

# Oracle Cloud (scripts/nube/migrar-a-nube.ps1): contrasena del usuario PANADERIA de la nube.
PSC_CLOUD_PASSWORD=
# Origen de la migracion (base local XE). Nunca se toma de DB_URL.
PSC_XE_DB_URL=
PSC_XE_DB_USER=
PSC_XE_DB_PASSWORD=
